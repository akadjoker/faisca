#version 450

// x += y

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Accumulator
{
    float x[];
};

layout(std430, binding = 1) readonly buffer Addend
{
    float y[];
};

layout(push_constant) uniform Push
{
    uint n;
} p;

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i < p.n)
    {
        x[i] += y[i];
    }
}
