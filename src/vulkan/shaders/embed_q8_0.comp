#version 450

// x[t] = row tokens[t] of a Q8_0 matrix, dequantized

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Scales
{
    uint scales[];
};

layout(std430, binding = 1) readonly buffer Quants
{
    uint quants[];
};

layout(std430, binding = 2) readonly buffer Tokens
{
    uint tokens[];
};

layout(std430, binding = 3) writeonly buffer Output
{
    float x[];
};

layout(push_constant) uniform Push
{
    uint n_embd;
    uint blocks;
} p;

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    const uint t = gl_WorkGroupID.y;
    if (i >= p.n_embd)
    {
        return;
    }
    const uint block = tokens[t] * p.blocks + i / 32;
    const float d = unpackHalf2x16(scales[block >> 1])[block & 1];
    const uint w = quants[block * 8 + (i % 32) / 4];
    x[t * p.n_embd + i] = d * float(bitfieldExtract(int(w), int(8 * (i % 4)), 8));
}
