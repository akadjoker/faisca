#version 450

// y[token][row] = w[row] . x[token], 32 threads per row

layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer Weights
{
    float w[];
};

layout(std430, binding = 1) readonly buffer Input
{
    float x[];
};

layout(std430, binding = 2) writeonly buffer Output
{
    float y[];
};

layout(push_constant) uniform Push
{
    uint n_in;
    uint n_out;
    uint x_stride;
    uint y_stride;
    uint n_tokens;
} p;

shared float partial[32];

void main()
{
    const uint row = gl_WorkGroupID.x;
    const uint token = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationID.x;
    float sum = 0.0;
    for (uint i = tid; i < p.n_in; i += 32)
    {
        sum += w[row * p.n_in + i] * x[token * p.x_stride + i];
    }
    partial[tid] = sum;
    barrier();
    for (uint s = 16; s > 0; s >>= 1)
    {
        if (tid < s)
        {
            partial[tid] += partial[tid + s];
        }
        barrier();
    }
    if (tid == 0)
    {
        y[token * p.y_stride + row] = partial[0];
    }
}
